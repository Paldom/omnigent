# Agent Army configuration. Copy to ./army.toml or ~/.omnigent/army.toml.
#
# No secrets here — this file sits next to the agent roster and should stay
# safe to commit. The server token is read from ARMY_TOKEN, and the broker key
# from ARMY_BROKER_KEY, both out of the environment.

[army]
# Where the Omnigent server is.
server_url = "http://localhost:6767"

# The loop's own state: runs, commands, and the effects journal. This is the
# file that has to survive a reboot. Back it up.
state_path = "~/.omnigent/army/army.db"

# Which job of work to run. "module:Class" — see army/workload.py for the five
# methods your own needs to implement.
workload = "army.workloads.demo:DemoWorkload"

# Iterations in flight at once. More than the number of vendors just queues
# work behind the same subscriptions.
max_concurrent_runs = 3

[workload_options]
# Constructor arguments for the workload above. These are the demo's.
queue_path = "army-queue.txt"

# Agent names as they appear in `GET /v1/agents` — Omnigent seeds one per
# vendor. Point the implementer and the reviewer at DIFFERENT vendors: a diff
# judged by the model that wrote it is judged by its own blind spots.
implementer_agent = "claude-native-ui"
reviewer_agent = "codex-native-ui"

# Host to pin sessions to. Omitted means "the first online host", which is
# right for a single box. A session with no host gets no runner and every
# message to it is refused.
# host_id = "..."

# Uncomment on a box with no working terminal: the *-native-ui agents wrap a
# resident vendor TUI in tmux and fail the turn if it cannot start. A headless
# harness has no such dependency. This must stay inside [workload_options] —
# under [lanes] it would be read as a lane and fail at startup.
# harness = "claude-sdk"

# Give each iteration its own checkout on its own branch, so two runs cannot
# edit the same files. Unset, everything shares `workspace` — fine for one run
# at a time, wrong the moment there are two. Worktrees are not cleaned up: the
# branch is the iteration's output. `git worktree prune` when you have read them.
worktrees = "~/.omnigent/army/worktrees"

[lanes]
# Concurrent sessions per vendor. Every sub-agent on one harness shares that
# harness's single login, so this is the real concurrency bound — not a global
# worker count. Start at two and raise a lane once you have watched it
# saturate without complaint from the vendor.
claude-native = 2
codex-native = 2
antigravity-native = 2
grok = 2
kimi-native = 2
pi-native = 2
